    "NSLocationWhenInUseUsageDescription": {
      "comment": "Location permission (setup: Use my location)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotonome uses your approximate location once, to suggest news from your town. Only the place name is saved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの町のニュースを提案するために、おおよその位置を一度だけ使います。保存するのは地名だけです。"
          }
        }
      }
    }
  },
  "version": "1.0"
